# Copy to .env and fill in. This file stays on your machine (.env is git-ignored).
# The engine reads these and uses each key only to talk to its own service as you.
# No key is logged, shown in the app, or sent to Layer.

# Layer: which markets are the same bet on Kalshi and Polymarket US. Get a key at https://uselayer.sh
LAYER_API_KEY=

# Kalshi: your own API key, to read Kalshi order books (and, in live mode, to place Kalshi orders).
# Create one in your Kalshi account settings. Ed25519 and RSA keys both work.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi.pem
# KALSHI_ENV=demo            # use Kalshi's demo exchange instead of production

# Polymarket US: only needed for live orders. Paper mode reads its public books without a key.
# POLYMARKET_US_KEY_ID=
# POLYMARKET_US_SECRET_KEY=

# The optional chat panel: your own LLM key. Anthropic, or OpenRouter (model anthropic/claude-opus-5.5).
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Paper (the default): real books, fake money, nothing reaches a venue.
# Live: real orders with your own keys. Only the exact word "live" turns it on.
BOT_MODE=paper
# BOT_BUDGET=100             # $ at risk across everything at once (the SDK's budget guardrail)
